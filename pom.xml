<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.2</version>
        <relativePath/> <!-- lookup parent from repository -->
    </parent>
    <groupId>ecom-ms-app</groupId>
    <artifactId>EBank-Microservices-App</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>EBank-Microservices-App</name>
    <description>EBank-Microservices-App Parent POM</description>

    <!-- Indique à Maven qu'il s'agit d'un projet agrégateur/parent -->
    <packaging>pom</packaging>

    <modules>
        <module>discovery-service</module>
        <module>customer-service</module>
        <module>ebank-service</module>
        <module>ebank-bot</module>
        <module>gateway-service</module>
    </modules>

    <properties>
        <java.version>21</java.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <!-- Le plugin spring-boot-maven-plugin a été retiré d'ici car il ne concerne que les microservices exécutables -->

</project>